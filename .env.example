APP_ENV=local
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKSPACE_DIR=./workspace
CHARACTER_DIR=./characters
PROVIDER_MODE=real
VISION_PROVIDER=unconfigured
IMAGE_PROVIDER=unconfigured
VIDEO_PROVIDER=unconfigured
COMPOSER_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_RUNS=1
MAX_CONCURRENT_IMAGE_TASKS=2
MAX_CONCURRENT_VIDEO_TASKS=1
# Relay base URLs and endpoint contracts are fixed in config/provider_relays.json.
# API keys are entered in WebUI and encrypted in workspace/app.db; never put them here.
RELAY_ID=kuaipao
RELAY_VIDEO_MODEL=doubao-seedance-2.0-mini-720p
RELAY_VIDEO_TIMEOUT_SECONDS=900
RELAY_VIDEO_POLL_INTERVAL_SECONDS=5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-5-mini
ALLOW_MOCK_GENERATION=false
WEBUI_AUTH_ENABLED=false
WEBUI_USERNAME=admin
# Set WEBUI_PASSWORD only in the ignored local .env file.
WEBUI_PASSWORD=
